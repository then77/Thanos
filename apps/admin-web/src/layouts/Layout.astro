---
import { Font } from 'astro:assets';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<Font family="Valley Sans" cssVariable="--font-valley-sans-variable" />
		<Font family="DM Sans" cssVariable="--font-dm-sans-variable" />
		<Font family="Lora" cssVariable="--font-lora-variable" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
