---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
    <ClientRouter />
    <Font family="Valley Sans" cssVariable="--font-valley-sans-variable" />
		<Font family="DM Sans" cssVariable="--font-dm-sans-variable" />
		<Font family="Lora" cssVariable="--font-lora-variable" />
  </head>
  <body
    class="dark flex flex-col min-h-screen"
    transition:persist
    transition:animate="none"
    transition:name="page-layout"
  >
    <slot />
  </body>
</html>
